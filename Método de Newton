        "##3. Implementación del Algoritmo 2.3 (Método de Newton)\n",
        "\n",
        "Se programa la función iterativa, almacenando las aproximaciones sucesivas ($p_n$) y los errores absolutos correspondientes para su posterior análisis tabular."
      ],
      "metadata": {
        "id": "_HA-TacdhWIg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def metodo_newton(p0, tol, N0=50):\n",
        "    i=1\n",
        "    error=100\n",
        "    L_iter=[]\n",
        "    L_pi=[]\n",
        "    L_error=[]\n",
        "\n",
        "    while i <= N0 and error > tol:\n",
        "        p1=p0-f(p0)/df(p0)\n",
        "        error=abs(p1-p0)\n",
        "        L_iter.append(i)\n",
        "        L_pi.append(p1)\n",
        "        L_error.append(error)\n",
        "        p0=p1\n",
        "        i+=1\n",
        "\n",
        "    resultados={\n",
        "        'n':L_iter,\n",
        "        'p_n':L_pi,\n",
        "        '|p_n-p_(n-1)|':L_error\n",
        "    }\n",
        "\n",
        "    return pd.DataFrame(resultados)\n"
      ],
      "metadata": {
        "id": "IZRYI6_Xhgaa"
      },
      "execution_count": 41,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "p_inicial=np.pi/4\n",
        "tolerancia=1e-7"
      ],
      "metadata": {
        "id": "fYcuE3gYh6Gd"
      },
      "execution_count": 42,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df_resultados=metodo_newton(p_inicial, tolerancia)"
      ],
      "metadata": {
        "id": "thFdsW34h8My"
      },
